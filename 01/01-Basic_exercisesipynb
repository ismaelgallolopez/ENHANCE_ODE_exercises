{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOiuTzZ/jXty6PHQGAjq+Mh"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["# Ex. 1"],"metadata":{"id":"CtjQJbg1bHqF"}},{"cell_type":"code","execution_count":1,"metadata":{"id":"-2YHlcko6KuC","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1782820724139,"user_tz":-120,"elapsed":3719,"user":{"displayName":"Tommaso Andena","userId":"03748314319744479163"}},"outputId":"079de8fa-04f8-4bbe-c493-e0471601c008"},"outputs":[{"output_type":"stream","name":"stderr","text":["/tmp/ipykernel_5838/1125533171.py:10: RuntimeWarning: overflow encountered in scalar power\n","  return (alpha / 2) * np.cos(t) * (1 - y**2)\n","/tmp/ipykernel_5838/1125533171.py:34: RuntimeWarning: invalid value encountered in scalar add\n","  y[n + 1] = y[n - 1] + 2 * dt * f(t[n], y[n], alpha)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1300x1000 with 4 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["import numpy as np\n","import matplotlib.pyplot as plt\n","from scipy.integrate import solve_ivp\n","from scipy.linalg import expm\n","\n","# Exercise 1\n","\n","# functions\n","def f1(t, y, alpha):\n","    return (alpha / 2) * np.cos(t) * (1 - y**2)\n","\n","def exact1(t, alpha):\n","    e = np.exp(alpha * np.sin(t))\n","    return (e - 1) / (e + 1)\n","\n","def euler1(f, y0, T, N, alpha):\n","    dt = T / N\n","    t = np.linspace(0, T, N + 1)\n","    y = np.zeros(N + 1)\n","    y[0] = y0\n","    for n in range(N):\n","        y[n + 1] = y[n] + dt * f(t[n], y[n], alpha)\n","    return t, y\n","\n","def leapfrog1(f, y0, T, N, alpha):\n","    \"\"\"2-step leapfrog: y_{n+1} = y_{n-1} + 2*dt*f(t_n, y_n)\"\"\"\n","    dt = T / N\n","    t = np.linspace(0, T, N + 1)\n","    y = np.zeros(N + 1)\n","    y[0] = y0\n","    # Bootstrap step 1 with Euler\n","    y[1] = y[0] + dt * f(t[0], y[0], alpha)\n","    for n in range(1, N):\n","        y[n + 1] = y[n - 1] + 2 * dt * f(t[n], y[n], alpha)\n","    return t, y\n","\n","# data\n","T1 = 6 * np.pi\n","y0_1 = 0.0\n","N_values = [800, 1600, 3200, 6400]\n","\n","fig, axes = plt.subplots(2, 2, figsize=(13, 10))\n","fig.suptitle(\"Exercise 1: Scalar nonlinear ODE\", fontsize=14)\n","\n","alpha1 = 1.0\n","alpha2 = 20.0\n","\n","for idx, alpha in enumerate([alpha1, alpha2]):\n","\n","    ax_sol = axes[idx, 0]\n","    ax_err = axes[idx, 1]\n","\n","    # Reference solution Scipy\n","    sol_ref = solve_ivp(lambda t, y: f1(t, y, alpha), [0, T1], [y0_1],\n","                        rtol=1e-10, atol=1e-12, dense_output=True)\n","\n","    # initialize errors and dts\n","    errors_euler = []\n","    errors_lf = []\n","    errors_scipy = []\n","    dts = []\n","\n","    for N in N_values:\n","\n","        # compute intervals size\n","        dt = T1 / N\n","        dts.append(dt)\n","\n","        # create the time grid\n","        t_eval = np.linspace(0, T1, N + 1)\n","\n","        # evaluate on the grid the exact sol\n","        y_ex = exact1(t_eval, alpha)\n","\n","        # numerical scheme\n","        _, y_eu = euler1(f1, y0_1, T1, N, alpha)\n","        _, y_lf = leapfrog1(f1, y0_1, T1, N, alpha)\n","\n","        # solve_ivp on the specified grid\n","        y_sp = sol_ref.sol(t_eval)\n","\n","        # compute errors and update data structures\n","        errors_euler.append(np.max(np.abs(y_eu - y_ex)))\n","        errors_lf.append(np.max(np.abs(y_lf - y_ex)))\n","        errors_scipy.append(np.max(np.abs(y_sp - y_ex)))\n","\n","\n","    # Plot solution for largest N\n","    N_plot = 6400\n","    t_fine = np.linspace(0, T1, N_plot + 1)\n","    _, y_eu_plot = euler1(f1, y0_1, T1, N_plot, alpha)\n","    _, y_lf_plot = leapfrog1(f1, y0_1, T1, N_plot, alpha)\n","    y_exact_plot = exact1(t_fine, alpha)\n","\n","    ax_sol.plot(t_fine, y_exact_plot, 'k-', label='Exact', lw=2)\n","    ax_sol.plot(t_fine, y_eu_plot, 'b--', label='Euler', lw=1)\n","    ax_sol.plot(t_fine, y_lf_plot, 'r:', label='Leapfrog', lw=1)\n","    ax_sol.set_title(f\"α={alpha}: Solution (N={N_plot})\")\n","    ax_sol.legend(); ax_sol.set_xlabel(\"t\"); ax_sol.set_ylabel(\"y\")\n","\n","    dts = np.array(dts)\n","    ax_err.loglog(dts, errors_euler, 'bs-', label='Euler')\n","    ax_err.loglog(dts, errors_lf, 'r^-', label='Leapfrog')\n","    ax_err.loglog(dts, errors_scipy, 'gD-', label='scipy solve_ivp')\n","    ax_err.loglog(dts, dts, 'k--', label='O(dt)')\n","    ax_err.loglog(dts, dts**2, 'k:', label='O(dt²)')\n","    ax_err.set_title(f\"α={alpha}: Max error vs dt\")\n","    ax_err.legend(); ax_err.set_xlabel(\"dt\"); ax_err.set_ylabel(\"max |error|\")\n","\n","plt.tight_layout()\n"]},{"cell_type":"markdown","source":["# Ex.2"],"metadata":{"id":"uJG8JZqwbK6k"}},{"cell_type":"code","source":["# Exercise 2\n","\n","# functions\n","def make_A(k, m, c):\n","    return np.array([[0, 1], [-k/m, -c/m]])\n","\n","def exact2(A, y0, t_eval):\n","    \"\"\"Exact solution: y(t) = expm(A*t) @ y0\"\"\"\n","    return np.array([expm(A * t) @ y0 for t in t_eval])  # shape (N+1, 2)\n","\n","def euler2_explicit(A, y0, T, N):\n","    dt = T / N\n","    t = np.linspace(0, T, N + 1)\n","    y = np.zeros((N + 1, 2))\n","    y[0] = y0\n","    for n in range(N):\n","        y[n + 1] = y[n] + dt * (A @ y[n])\n","    return t, y\n","\n","def euler2_implicit(A, y0, T, N):\n","    \"\"\"Implicit Euler: (I - dt*A) y_{n+1} = y_n  => solved with np.linalg.solve\"\"\"\n","    dt = T / N\n","    t = np.linspace(0, T, N + 1)\n","    y = np.zeros((N + 1, 2))\n","    y[0] = y0\n","    M = np.eye(2) - dt * A\n","    for n in range(N):\n","        y[n + 1] = np.linalg.solve(M, y[n]) # solve the implicit step\n","    return t, y\n","\n","# Test cases\n","cases = [\n","    dict(k=1.0, m=1.0, c=0.0,  y0=np.array([1.0, 0.0]), T=10.0, label=\"Undamped\"),\n","    dict(k=4.0, m=1.0, c=0.5,  y0=np.array([1.0, 0.0]), T=10.0, label=\"Underdamped\"),\n","    dict(k=1.0, m=1.0, c=10.0, y0=np.array([1.0, 0.0]), T=10.0, label=\"Overdamped\"),\n","]\n","\n","fig, axes = plt.subplots(len(cases), 2, figsize=(13, 4 * len(cases)))\n","fig.suptitle(\"Exercise 2: Damped harmonic oscillator\", fontsize=14)\n","\n","for row, case in enumerate(cases):\n","\n","    A = make_A(case['k'], case['m'], case['c'])\n","    y0 = case['y0']\n","    T = case['T']\n","\n","    N_values2 = [50, 100, 200, 400, 800]\n","\n","    # initialize errors and dts\n","    errors_ex = []\n","    errors_im = []\n","    dts = []\n","\n","    for N in N_values2:\n","        dt = T / N\n","        t_eval = np.linspace(0, T, N + 1)\n","        y_ex_arr = exact2(A, y0, t_eval)\n","        _, y_eu = euler2_explicit(A, y0, T, N)\n","        _, y_im = euler2_implicit(A, y0, T, N)\n","\n","        errors_ex.append(np.max(np.linalg.norm(y_eu - y_ex_arr, axis=1)))\n","        errors_im.append(np.max(np.linalg.norm(y_im - y_ex_arr, axis=1)))\n","        dts.append(dt)\n","\n","    # Solution plot (best N) for each case\n","    N_plot = 400\n","    t_plot = np.linspace(0, T, N_plot + 1)\n","    y_exact_plot = exact2(A, y0, t_plot)\n","    _, y_eu_plot = euler2_explicit(A, y0, T, N_plot)\n","    _, y_im_plot = euler2_implicit(A, y0, T, N_plot)\n","\n","    ax_s = axes[row, 0]\n","    ax_s.plot(t_plot, y_exact_plot[:, 0], 'k-', label='Exact', lw=2)\n","    ax_s.plot(t_plot, y_eu_plot[:, 0], 'b--', label='Expl. Euler', lw=1)\n","    ax_s.plot(t_plot, y_im_plot[:, 0], 'r:', label='Impl. Euler', lw=1)\n","    ax_s.set_title(f\"{case['label']}: y1(t)\")\n","    ax_s.legend(); ax_s.set_xlabel(\"t\"); ax_s.set_ylabel(\"y1\")\n","\n","    dts = np.array(dts)\n","    ax_e = axes[row, 1]\n","    ax_e.loglog(dts, errors_ex, 'bs-', label='Expl. Euler')\n","    ax_e.loglog(dts, errors_im, 'r^-', label='Impl. Euler')\n","    ax_e.loglog(dts, dts, 'k--', label='O(dt)')\n","    ax_e.set_title(f\"{case['label']}: Max error vs dt\")\n","    ax_e.legend(); ax_e.set_xlabel(\"dt\"); ax_e.set_ylabel(\"max error\")\n","\n","plt.tight_layout()"],"metadata":{"id":"2gZnUDKi6buX","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1782821076239,"user_tz":-120,"elapsed":3964,"user":{"displayName":"Tommaso Andena","userId":"03748314319744479163"}},"outputId":"2c9a2e07-ab81-42ca-fdbc-893500aa3006"},"execution_count":2,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1300x1200 with 6 Axes>"],"image/png":"\n"},"metadata":{}}]}]}